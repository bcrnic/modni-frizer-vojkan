# ─── Supabase (frontend) ──────────────────────────────────────────────────────
# Naći u: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...YOUR_ANON_KEY

# ─── Supabase Edge Function secrets ──────────────────────────────────────────
# Ove NE idu u .env.local – postavljaju se kao Supabase Secrets:
# supabase secrets set RESEND_API_KEY=re_...
# supabase secrets set SALON_EMAIL=vojkan@tvojdomen.rs
# supabase secrets set SENDER_EMAIL=noreply@tvojdomen.rs
# supabase secrets set SALON_ADDRESS="Uspenska 1, ulaz iz Pavla Papa, Novi Sad"
# supabase secrets set SALON_PHONE="+381 62 144 5958"
#
# RESEND_API_KEY   – API ključ sa resend.com (besplatno do 3000 emailova/mesec)
# SALON_EMAIL      – email na koji stižu notifikacije o novim terminima (tvoj email)
# SENDER_EMAIL     – email sa kojeg se šalju poruke (mora biti verifikovan domen na Resend)
